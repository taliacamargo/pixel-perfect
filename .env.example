# Copie este arquivo para .env.local e preencha com as suas chaves.
# O .env.local nunca vai para o git. Na Vercel, cadastre as mesmas variáveis no painel.

# Stripe > Desenvolvedores > Chaves de API. Em produção, use uma chave restrita (rk_live_...).
STRIPE_SECRET_KEY=
# Chave publicável da mesma conta e ambiente da chave do servidor.
VITE_STRIPE_PUBLISHABLE_KEY=
# Segredo de assinatura do destino de eventos (whsec_...), diferente da chave de API.
STRIPE_WEBHOOK_SECRET=

# Senha do painel em /painel (use uma senha longa, com 16+ caracteres)
ADMIN_PASSWORD=
# Segundo fator do painel. Gere com: pnpm gerar-2fa
ADMIN_TOTP_SECRET=

# Upstash Redis (limite de tentativas). Criado pela integração da Vercel; sem ele,
# os limites ficam só na memória do servidor.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile (anti-robô no pagamento). Para testar no computador, use as
# chaves de teste da Cloudflare: 1x00000000000000000000AA e
# 1x0000000000000000000000000000000AA.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Microsoft Clarity (mapas de calor). ID do projeto em clarity.microsoft.com >
# Configurações > Visão geral. Sem ele, o Clarity não carrega. Nunca roda no
# localhost nem no /painel.
VITE_CLARITY_ID=

KV_REST_API_READ_ONLY_TOKEN=
KV_REST_API_TOKEN=
KV_REST_API_URL=
KV_URL=
REDIS_URL=
