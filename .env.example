# Copie este arquivo para .env.local e preencha com as suas chaves.
# O .env.local nunca vai para o git. Na Vercel, cadastre as mesmas variáveis no painel.

# Stripe > Desenvolvedores > Chaves de API (use sk_test_... para testar)
STRIPE_SECRET_KEY=

# Senha do painel em /painel (use uma senha longa, com 16+ caracteres)
ADMIN_PASSWORD=
